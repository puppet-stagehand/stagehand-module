<%- | Array[String[1]] $uris, String[1] $client_yaml | -%>
# Managed by stagehand::console_integration — environment hiera.yaml.
# The console Data Service tier sits ABOVE the on-disk tiers so console-served
# data wins, falling back to yaml (and last-good cache) when unavailable.
#
# $uris is the ordered tier list the console owns (console's
# renderHieraHierarchy is the single source of truth for tier order — see
# docs/design/module-architecture.md); this template emits it verbatim and
# does not re-append a trailing "common" itself.
version: 5
defaults:
  datadir: data
  data_hash: yaml_data
hierarchy:
  - name: "Console data (Data Service)"
    data_hash: stagehand::hiera_data
    uris:
<% $uris.each |$uri| { -%>
      - "<%= $uri %>"
<% } -%>
    options:
      config: <%= $client_yaml %>
      on_error: use_cache
  - name: "Per-node yaml"
    path: "nodes/%{trusted.certname}.yaml"
  - name: "Common yaml"
    path: "common.yaml"
