<%- | String[1] $addr,
      String[1] $database_url,
      String[1] $seed_puppetserver_host,
      Integer[1] $seed_puppetserver_port,
      String[1] $seed_puppetdb_host,
      Integer[1] $seed_puppetdb_port,
      Stdlib::Absolutepath $seed_cert,
      Stdlib::Absolutepath $seed_key,
      Stdlib::Absolutepath $seed_cacert,
      Stdlib::Absolutepath $bolt_path,
      Stdlib::Absolutepath $bolt_project,
      String[1] $external_url,
      String[1] $ingest_token,
      String[1] $dataservice_token,
      String $hierascope_path,
      String $hierascope_version,
      String $hierascope_protocol,
      String $hierascope_sha256,
      String $hierascope_key_id,
      String $hierascope_signature,
      String $hierascope_goos,
      String $hierascope_goarch,
      String $hierascope_hiera_config,
      String $hierascope_puppet_major,
| -%>
# Managed by stagehand::console — do not edit by hand.
# EnvironmentFile for the puppet-console.service systemd unit.
PSH_ADDR=<%= $addr %>
PSH_DATABASE_URL=<%= $database_url %>
PSH_SEED_PUPPETSERVER_HOST=<%= $seed_puppetserver_host %>
PSH_SEED_PUPPETSERVER_PORT=<%= $seed_puppetserver_port %>
PSH_SEED_PUPPETDB_HOST=<%= $seed_puppetdb_host %>
PSH_SEED_PUPPETDB_PORT=<%= $seed_puppetdb_port %>
PSH_SEED_CERT=<%= $seed_cert %>
PSH_SEED_KEY=<%= $seed_key %>
PSH_SEED_CACERT=<%= $seed_cacert %>
PSH_BOLT_PATH=<%= $bolt_path %>
PSH_BOLT_PROJECT=<%= $bolt_project %>
PSH_EXTERNAL_URL=<%= $external_url %>
PSH_INGEST_TOKEN=<%= $ingest_token %>
PSH_DATASERVICE_TOKEN=<%= $dataservice_token %>
PCC_HIERASCOPE_PATH=<%= $hierascope_path %>
PCC_HIERASCOPE_VERSION=<%= $hierascope_version %>
PCC_HIERASCOPE_PROTOCOL=<%= $hierascope_protocol %>
PCC_HIERASCOPE_SHA256=<%= $hierascope_sha256 %>
PCC_HIERASCOPE_KEY_ID=<%= $hierascope_key_id %>
PCC_HIERASCOPE_SIGNATURE=<%= $hierascope_signature %>
PCC_HIERASCOPE_GOOS=<%= $hierascope_goos %>
PCC_HIERASCOPE_GOARCH=<%= $hierascope_goarch %>
PCC_HIERASCOPE_HIERA_CONFIG=<%= $hierascope_hiera_config %>
PCC_HIERASCOPE_PUPPET_MAJOR=<%= $hierascope_puppet_major %>
