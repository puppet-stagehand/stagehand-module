<%- | String[1] $namespace,
      String[1] $db_password,
      String[1] $ingest_token,
      String[1] $dataservice_token,
| -%>
# Managed by stagehand::console::k3s -- do not edit by hand.
#
# The ONLY point in stagehand::console::k3s where a Sensitive value is
# unwrapped is the parameter hash passed to this template's own epp() call
# in k3s.pp (three .unwrap calls, one per Sensitive parameter) -- every
# other rendered manifest (console, PostgreSQL) references this Secret
# object by name and key only, never by literal value. This template
# itself receives plain (already-unwrapped) String[1] values, not
# Sensitive[String[1]] -- the unwrap happened one call frame up.
#
# Rendered by a File resource at mode 0600 with show_diff => false (see
# k3s.pp) -- both mandatory: mode 0600 keeps this file off a
# world-readable host filesystem, and show_diff => false keeps its
# content out of Puppet run reports and logs (999.22-RESEARCH.md Security
# Domain table, puppet-best-practices secret-handling conventions).
#
# `username`/`password` are the exact key names CloudNativePG's own
# `cluster.initdb.secret` bootstrap config expects
# (manifests/base/postgresql/postgresql.yaml); `password` doubles as the
# key the console's own PSH_DATABASE_URL composition reads via
# secretKeyRef plus Kubernetes' $(VAR) env-value substitution (see
# console-helmchart.epp) -- one Secret, one password value, two readers.
apiVersion: v1
kind: Secret
metadata:
  name: stagehand-console-secrets
  namespace: <%= $namespace %>
type: Opaque
stringData:
  username: "psh"
  password: "<%= $db_password %>"
  ingest-token: "<%= $ingest_token %>"
  dataservice-token: "<%= $dataservice_token %>"
